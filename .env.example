# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=
# URL pública del sitio (canonical, sitemap, robots.txt, Open Graph). Por defecto http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Smoke tests (npm run test:smoke). URL de la instancia a probar, p. ej. http://localhost:3100 o https://site-check-engine.vercel.app.
SMOKE_BASE_URL=
# Usuario demo para la parte con sesión del smoke. Solo en .env.local: nunca en el repositorio ni en logs.
DEMO_EMAIL=
DEMO_PASSWORD=
